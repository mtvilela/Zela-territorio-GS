{
  "expo": {
    "name": "Zela Território",
    "slug": "zela-territorio",
    "description": "Painel de Inteligência Territorial: indicadores, alertas preditivos explicados e apoio à decisão do gestor público.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zelaterritorio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "pt-BR",
      "themeColor": "#0F766E",
      "shortName": "Zela Território"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 160,
          "backgroundColor": "#0F766E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
